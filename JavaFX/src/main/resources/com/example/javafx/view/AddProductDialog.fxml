<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javafx.Controller.AddProductDialogController"
      spacing="15" style="-fx-background-color: white; -fx-padding: 20;">

    <Label text="Ajouter un nouveau produit"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Separator/>

    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints minWidth="300" prefWidth="300"/>
        </columnConstraints>

        <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Ex: Château Margaux"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Catégorie :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="categoryCombo" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Année :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="yearField" promptText="Ex: 2018"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>


        <Label text="Quantité :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="quantityField" promptText="Ex: 50"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>


        <Label text="Prix unitaire (€) :" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="priceField" promptText="Ex: 45.99"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>


        <Label text="Région :" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="areaField" promptText="Ex: Bordeaux"
                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Fournisseur :" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <ComboBox fx:id="supplierCombo" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="6"/>

    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #E0E0E0; -fx-padding: 10 20;"/>
        <Button text="Ajouter" onAction="#handleAdd"
                style="-fx-background-color: #1E152A; -fx-text-fill: white; -fx-padding: 10 20;"/>
    </HBox>
</VBox>
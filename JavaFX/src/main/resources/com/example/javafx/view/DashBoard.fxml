<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx.Controller.HomeScreenController">

    <left>
        <fx:include fx:id="sidebar" source="menu.fxml" />
    </left>

    <center>
        <BorderPane styleClass="content">
            <top>
                <VBox spacing="16.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Dashboard">
                            <font><Font size="30.0" /></font>
                            <styleClass>title</styleClass>
                            <padding>
                                <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                            </padding>
                        </Label>

                        <HBox spacing="16.0">
                            <children>
                                <PieChart fx:id="pieChart" prefHeight="400.0" prefWidth="637.0" title="Graphique" />
                                <LineChart prefHeight="400.0" prefWidth="691.0">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis side="LEFT" />
                                    </yAxis>
                                </LineChart>
                            </children>
                            <padding>
                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <bottom>
                <StackPane styleClass="card" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" />
                    </padding>
                </StackPane>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx.Controller.ClientsController">
    <left>
        <fx:include fx:id="sidebar" source="menu.fxml" />
    </left>
    <center>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="12.0" prefHeight="12.0" prefWidth="524.0" text="Gestion clients">
                    <font>
                        <Font size="45.0" />
                    </font>
                </Label>

                <Button fx:id="createUserButton" layoutX="63.0" layoutY="70.0" text="+ Créer un nouveau client"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                        onAction="#handleCreateUser"/>

                <Label layoutX="63.0" layoutY="128.0" text="Recherche clients" />
                <TableView layoutX="63.0" layoutY="164.0" prefHeight="480.0" prefWidth="364.0" fx:id="tableClients">
                    <columns>
                        <TableColumn fx:id="clientidColumn" prefWidth="64.0" text="UID" />
                        <TableColumn fx:id="firstnameColumn" prefWidth="150.0" text="Prénom" />
                        <TableColumn fx:id="lastnameColumn" prefWidth="150.0" text="Nom" />
                    </columns>
                </TableView>

                <!-- User Details Panel with ScrollPane for all fields -->
                <ScrollPane layoutX="500.0" layoutY="164.0" prefWidth="400.0" prefHeight="480.0"
                            fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox fx:id="userDetailsPanel" prefWidth="380.0" spacing="15" visible="false">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>

                        <Label text="Détails du client" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                        <Separator/>

                        <VBox spacing="12">
                            <HBox spacing="10">
                                <Label text="UID:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailUid" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Prénom:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailFirstname" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Nom:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailLastname" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Email:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailEmail" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Téléphone:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailPhone" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Adresse:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailAddress" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Rôle:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailRole" text="" wrapText="true"/>
                            </HBox>

                            <HBox spacing="10">
                                <Label text="Bouteilles achetées:" style="-fx-font-weight: bold;" prefWidth="150"/>
                                <Label fx:id="detailBottles" text="" wrapText="true"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <VBox spacing="15">
                            <Button fx:id="editButton" text="Modifier le profil" prefWidth="340"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"
                                    onAction="#handleEditProfile"/>

                            <Button fx:id="deleteButton" text="Supprimer le profil" prefWidth="340"
                                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"
                                    onAction="#handleDeleteProfile"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </children>
        </AnchorPane>
    </center>
</BorderPane>